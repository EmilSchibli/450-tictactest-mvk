#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/tictactest-init.log) 2>&1

dnf install -y python3 unzip

install -d /opt/corretto
curl -fsSL -o /tmp/corretto.tar.gz "${corretto_url}"
echo "${corretto_sha256}  /tmp/corretto.tar.gz" | sha256sum -c -
tar -xzf /tmp/corretto.tar.gz -C /opt/corretto --strip-components=1
rm /tmp/corretto.tar.gz

curl -fsSL -o /usr/local/bin/ttyd "${ttyd_url}"
echo "${ttyd_sha256}  /usr/local/bin/ttyd" | sha256sum -c -
chmod 755 /usr/local/bin/ttyd

if ! id tictactoe >/dev/null 2>&1; then
  useradd --system --home-dir /opt/tictactest --create-home --shell /sbin/nologin tictactoe
fi
install -d -o tictactoe -g tictactoe /opt/tictactest/app

echo "${fetch_b64}" | base64 -d > /opt/tictactest/fetch.sh
chmod 755 /opt/tictactest/fetch.sh
chown root:root /opt/tictactest/fetch.sh

echo "${unit_b64}" | base64 -d > /etc/systemd/system/tictactest.service
systemctl daemon-reload
systemctl enable tictactest.service
