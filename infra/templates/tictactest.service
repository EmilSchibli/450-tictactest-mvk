[Unit]
Description=TicTacTest web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tictactoe
Group=tictactoe
WorkingDirectory=/opt/tictactest/app
Environment=TICTACTEST_BIND=0.0.0.0
Environment=PATH=/opt/corretto/bin:/usr/local/bin:/usr/bin
ExecStartPre=/opt/tictactest/fetch.sh
ExecStart=/opt/tictactest/app/start-webconsole.sh
KillMode=control-group
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
